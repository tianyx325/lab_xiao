{
  "name": "lab-xiao",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/hugo.mjs server -D -p 1314 --bind 127.0.0.1 --baseURL http://127.0.0.1:1314/lab_xiao/ -d resources/_dev-server --disableFastRender",
    "check:theme": "node scripts/check-theme-sync.mjs",
    "check:content": "node scripts/check-content-schema.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:tokens": "node scripts/check-lab-hardcodes.mjs",
    "check": "npm run check:theme && npm run check:content && npm run check:i18n && npm run check:tokens",
    "test": "npm run check",
    "build:lab-css": "node scripts/check-lab-compile.mjs && node scripts/merge-lab-css.mjs",
    "build": "node scripts/hugo.mjs --minify"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "sass": "^1.93.2",
    "sass-embedded": "^1.77.8"
  }
}
